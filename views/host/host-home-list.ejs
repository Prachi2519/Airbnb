<%- include('../partials/head') %>
  </head>
  <body>
    <%- include('../partials/nav') %>
    <main class="section-shell">
      <%- include('../partials/flash') %>
      <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-sm font-semibold text-rose-700">Host dashboard</p>
          <h1 class="mt-1 text-3xl font-bold tracking-tight text-slate-950">Manage your stays</h1>
          <p class="mt-2 max-w-2xl text-slate-600">Track listings, upcoming bookings, and availability from one place.</p>
        </div>
        <a href="/host/add-home" class="btn-primary">Add listing</a>
      </div>

      <section class="mb-8 grid gap-4 sm:grid-cols-3">
        <div class="metric-card">
          <p class="text-sm font-medium text-slate-500">Active listings</p>
          <p class="mt-2 text-3xl font-bold text-slate-950"><%= stats.activeListings %></p>
        </div>
        <div class="metric-card">
          <p class="text-sm font-medium text-slate-500">Upcoming bookings</p>
          <p class="mt-2 text-3xl font-bold text-slate-950"><%= stats.upcomingBookings %></p>
        </div>
        <div class="metric-card">
          <p class="text-sm font-medium text-slate-500">Blocked dates</p>
          <p class="mt-2 text-3xl font-bold text-slate-950"><%= stats.blockedDates %></p>
        </div>
      </section>

      <% if (bookings && bookings.length > 0) { %>
        <section class="mb-8 card p-5">
          <h2 class="text-xl font-bold text-slate-950">Upcoming guest stays</h2>
          <div class="mt-4 divide-y divide-stone-200">
            <% bookings.slice(0, 5).forEach(booking => { %>
              <div class="flex flex-col gap-2 py-3 sm:flex-row sm:items-center sm:justify-between">
                <div>
                  <p class="font-semibold text-slate-950"><%= booking.home ? booking.home.houseName : 'Listing' %></p>
                  <p class="text-sm text-slate-500"><%= booking.guest ? booking.guest.firstName : 'Guest' %> · <%= formatDate(booking.checkIn) %> - <%= formatDate(booking.checkOut) %> · <%= booking.guestCount %> guests</p>
                </div>
                <span class="badge"><%= formatCurrency(booking.totalPrice) %></span>
              </div>
            <% }) %>
          </div>
        </section>
      <% } %>

      <% if (registeredHomes.length === 0) { %>
        <div class="rounded-lg border border-dashed border-stone-300 bg-white p-10 text-center">
          <h2 class="text-xl font-semibold text-slate-950">You have no listings yet</h2>
          <p class="mt-2 text-slate-600">Publish a detailed listing and start welcoming guests.</p>
          <a href="/host/add-home" class="btn-primary mt-6">Create listing</a>
        </div>
      <% } else { %>
        <div class="grid gap-5 lg:grid-cols-2">
          <% registeredHomes.forEach(home => { %>
            <article class="overflow-hidden rounded-lg border border-stone-200 bg-white shadow-sm">
              <div class="grid sm:grid-cols-[14rem_1fr]">
                <img src="<%= assetPath((home.images && home.images[0]) || home.photo) %>" alt="<%= home.houseName %>" class="h-56 w-full object-cover sm:h-full" />
                <div class="flex flex-col justify-between gap-5 p-5">
                  <div>
                    <div class="flex items-start justify-between gap-4">
                      <div class="min-w-0">
                        <h2 class="truncate text-lg font-semibold text-slate-950"><%= home.houseName %></h2>
                        <p class="mt-1 truncate text-sm text-slate-500"><%= home.location %></p>
                      </div>
                      <p class="badge"><%= home.status %></p>
                    </div>
                    <p class="mt-3 text-sm text-slate-500"><%= home.maxGuests || 2 %> guests · <%= home.bedrooms || 1 %> bedrooms · <%= home.bathrooms || 1 %> baths</p>
                    <p class="mt-4 line-clamp-2 text-sm leading-6 text-slate-600"><%= home.description %></p>
                  </div>
                  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                    <p class="font-bold text-slate-950"><%= formatCurrency(home.price) %> <span class="text-sm font-medium text-slate-500">night</span></p>
                    <div class="flex gap-2">
                      <a href="/host/edit-home/<%=home._id%>?editing=true" class="btn-secondary">Edit</a>
                      <form action="/host/delete-home/<%= home._id %>" method="POST">
                        <button type="submit" class="btn-secondary text-rose-700 hover:text-rose-800">Delete</button>
                      </form>
                    </div>
                  </div>
                </div>
              </div>
              <form action="/host/calendar/<%= home._id %>" method="POST" class="border-t border-stone-200 p-5">
                <label class="mb-2 block text-sm font-semibold text-slate-800">Blocked dates for this listing</label>
                <textarea name="blockedDates" rows="2" class="field" placeholder="2026-06-12, 2026-06-13"><%= (home.blockedDates || []).join(', ') %></textarea>
                <div class="mt-3 flex justify-end">
                  <button class="btn-secondary" type="submit">Update calendar</button>
                </div>
              </form>
            </article>
          <% }) %>
        </div>
      <% } %>
    </main>
  </body>
</html>
