<%- include('../partials/head') %>
  </head>
  <body>
    <%- include('../partials/nav') %>
    <main class="section-shell">
      <%- include('../partials/flash') %>
      <div class="grid gap-8 lg:grid-cols-[0.75fr_1.25fr]">
        <aside class="lg:pt-10">
          <p class="text-sm font-semibold text-rose-700">Host setup</p>
          <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950">
            <%= editing ? "Refine your listing" : "Create a high-converting listing" %>
          </h1>
          <p class="mt-4 leading-7 text-slate-600">
            Strong listings combine useful details, clear rules, enough capacity information, and availability guests can trust.
          </p>
          <% const previewImage = editing && home && ((home.images && home.images[0]) || home.photo); %>
          <% if (previewImage) { %>
            <img src="<%= assetPath(previewImage) %>" alt="<%= home.houseName %>" class="mt-8 aspect-[4/3] w-full rounded-lg object-cover shadow-sm" />
          <% } %>
        </aside>

        <section class="rounded-lg border border-stone-200 bg-white p-6 shadow-sm sm:p-8">
          <%- include('../partials/errors') %>
          <form action="/host/<%= editing ? "edit-home" : "add-home" %>" method="POST" enctype="multipart/form-data" class="space-y-6">
            <input type="hidden" name="id" value="<%= editing ? home._id : '' %>" />

            <div class="grid gap-5 sm:grid-cols-2">
              <div class="sm:col-span-2">
                <label for="houseName" class="mb-2 block text-sm font-semibold text-slate-800">Listing name</label>
                <input id="houseName" type="text" name="houseName" value="<%= oldInput.houseName || (editing ? home.houseName : '') %>" placeholder="Modern villa near the lake" class="field" required />
              </div>
              <div>
                <label for="price" class="mb-2 block text-sm font-semibold text-slate-800">Price per night</label>
                <input id="price" type="number" name="price" min="1" value="<%= oldInput.price || (editing ? home.price : '') %>" placeholder="4500" class="field" required />
              </div>
              <div>
                <label for="rating" class="mb-2 block text-sm font-semibold text-slate-800">Guest rating</label>
                <input id="rating" type="number" name="rating" min="1" max="5" step="0.1" value="<%= oldInput.rating || (editing ? home.rating : '4.8') %>" placeholder="4.8" class="field" required />
              </div>
              <div class="sm:col-span-2">
                <label for="location" class="mb-2 block text-sm font-semibold text-slate-800">Location</label>
                <input id="location" type="text" name="location" value="<%= oldInput.location || (editing ? home.location : '') %>" placeholder="Goa, India" class="field" required />
              </div>
            </div>

            <div class="grid gap-5 sm:grid-cols-3">
              <div>
                <label for="maxGuests" class="mb-2 block text-sm font-semibold text-slate-800">Max guests</label>
                <input id="maxGuests" type="number" name="maxGuests" min="1" value="<%= oldInput.maxGuests || (editing ? home.maxGuests : '2') %>" class="field" required />
              </div>
              <div>
                <label for="bedrooms" class="mb-2 block text-sm font-semibold text-slate-800">Bedrooms</label>
                <input id="bedrooms" type="number" name="bedrooms" min="0" value="<%= oldInput.bedrooms || (editing ? home.bedrooms : '1') %>" class="field" required />
              </div>
              <div>
                <label for="bathrooms" class="mb-2 block text-sm font-semibold text-slate-800">Bathrooms</label>
                <input id="bathrooms" type="number" name="bathrooms" min="0" value="<%= oldInput.bathrooms || (editing ? home.bathrooms : '1') %>" class="field" required />
              </div>
            </div>

            <div>
              <label for="photos" class="mb-2 block text-sm font-semibold text-slate-800">Listing photos</label>
              <input id="photos" type="file" name="photos" accept="image/jpg, image/jpeg, image/png" multiple class="field" <%= editing ? "" : "required" %> />
              <p class="mt-2 text-xs text-slate-500">Upload up to 8 JPG or PNG images. New uploads replace existing listing photos.</p>
            </div>

            <div>
              <label for="description" class="mb-2 block text-sm font-semibold text-slate-800">Description</label>
              <textarea id="description" name="description" rows="6" placeholder="Describe the space, neighborhood, and guest experience." class="field" required><%= oldInput.description || (editing ? home.description : '') %></textarea>
            </div>

            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="amenities" class="mb-2 block text-sm font-semibold text-slate-800">Amenities</label>
                <textarea id="amenities" name="amenities" rows="5" placeholder="Wifi, Kitchen, Pool" class="field"><%= oldInput.amenities || (editing ? (home.amenities || []).join(', ') : 'Wifi, Kitchen, Air conditioning, Workspace') %></textarea>
              </div>
              <div>
                <label for="houseRules" class="mb-2 block text-sm font-semibold text-slate-800">House rules</label>
                <textarea id="houseRules" name="houseRules" rows="5" placeholder="No smoking, No parties" class="field"><%= oldInput.houseRules || (editing ? (home.houseRules || []).join(', ') : 'No smoking, No parties, Respect quiet hours') %></textarea>
              </div>
            </div>

            <div>
              <label for="blockedDates" class="mb-2 block text-sm font-semibold text-slate-800">Blocked dates</label>
              <textarea id="blockedDates" name="blockedDates" rows="4" placeholder="2026-06-12, 2026-06-13" class="field"><%= oldInput.blockedDates || (editing ? (home.blockedDates || []).join(', ') : '') %></textarea>
              <p class="mt-2 text-xs text-slate-500">Enter unavailable dates as YYYY-MM-DD, separated by commas or new lines.</p>
            </div>

            <div>
              <label for="status" class="mb-2 block text-sm font-semibold text-slate-800">Listing status</label>
              <select id="status" name="status" class="field">
                <option value="active" <%= (oldInput.status || (editing ? home.status : 'active')) === 'active' ? 'selected' : '' %>>Active</option>
                <option value="draft" <%= (oldInput.status || (editing ? home.status : 'active')) === 'draft' ? 'selected' : '' %>>Draft</option>
              </select>
            </div>

            <div class="flex flex-col-reverse gap-3 pt-2 sm:flex-row sm:justify-end">
              <a href="/host/host-home-list" class="btn-secondary">Cancel</a>
              <button type="submit" class="btn-primary"><%= editing ? "Update listing" : "Publish listing" %></button>
            </div>
          </form>
        </section>
      </div>
    </main>
  </body>
</html>
