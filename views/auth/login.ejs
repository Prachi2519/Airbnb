<%- include('../partials/head') %>
  </head>
  <body>
    <%- include('../partials/nav') %>
    <main class="section-shell grid min-h-[calc(100vh-5rem)] items-center gap-10 lg:grid-cols-[0.9fr_1.1fr]">
      <section class="hidden lg:block">
        <p class="text-sm font-semibold text-rose-700">Welcome back</p>
        <h1 class="mt-3 text-5xl font-bold tracking-tight text-slate-950">Pick up exactly where you left off.</h1>
        <p class="mt-5 max-w-xl text-lg leading-8 text-slate-600">Guests can continue planning trips. Hosts can manage listings with a focused dashboard.</p>
      </section>

      <section class="mx-auto w-full max-w-md rounded-lg border border-stone-200 bg-white p-6 shadow-sm sm:p-8">
        <h2 class="text-2xl font-bold tracking-tight text-slate-950">Log in</h2>
        <p class="mt-2 text-sm text-slate-600">Use your account email and password.</p>

        <form action="/login" method="POST" class="mt-6 space-y-5">
          <%- include('../partials/errors') %>
          <div>
            <label for="email" class="mb-2 block text-sm font-semibold text-slate-800">Email address</label>
            <input type="email" id="email" name="email" placeholder="you@example.com" value="<%= oldInput.email ? oldInput.email : '' %>" class="field" required />
          </div>
          <div>
            <label for="password" class="mb-2 block text-sm font-semibold text-slate-800">Password</label>
            <input type="password" id="password" name="password" placeholder="Your password" class="field" required />
          </div>
          <button type="submit" class="btn-primary w-full">Log in</button>
        </form>

        <p class="mt-6 text-center text-sm text-slate-600">
          New here? <a href="/signup" class="font-semibold text-rose-700 hover:text-rose-800">Create an account</a>
        </p>
      </section>
    </main>
  </body>
</html>
