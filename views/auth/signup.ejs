<%- include('../partials/head') %>
  </head>
  <body>
    <%- include('../partials/nav') %>
    <main class="section-shell grid min-h-[calc(100vh-5rem)] items-center gap-10 lg:grid-cols-[0.85fr_1.15fr]">
      <section class="hidden lg:block">
        <p class="text-sm font-semibold text-rose-700">Join StayNest</p>
        <h1 class="mt-3 text-5xl font-bold tracking-tight text-slate-950">One account for better trips and better hosting.</h1>
        <p class="mt-5 max-w-xl text-lg leading-8 text-slate-600">Choose guest or host during signup so the product opens into the right workflow immediately.</p>
      </section>

      <section class="mx-auto w-full max-w-2xl rounded-lg border border-stone-200 bg-white p-6 shadow-sm sm:p-8">
        <h2 class="text-2xl font-bold tracking-tight text-slate-950">Create account</h2>
        <p class="mt-2 text-sm text-slate-600">Tell us who you are and how you want to use the platform.</p>

        <form action="/signup" method="POST" class="mt-6 space-y-5">
          <%- include('../partials/errors') %>

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="firstName" class="mb-2 block text-sm font-semibold text-slate-800">First name</label>
              <input type="text" id="firstName" name="firstName" placeholder="Prachi" value="<%= oldInput.firstName ? oldInput.firstName : '' %>" class="field" required />
            </div>
            <div>
              <label for="lastName" class="mb-2 block text-sm font-semibold text-slate-800">Last name</label>
              <input type="text" id="lastName" name="lastName" placeholder="Sharma" value="<%= oldInput.lastName ? oldInput.lastName : '' %>" class="field" />
            </div>
          </div>

          <div>
            <label for="email" class="mb-2 block text-sm font-semibold text-slate-800">Email address</label>
            <input type="email" id="email" name="email" placeholder="you@example.com" value="<%= oldInput.email ? oldInput.email : '' %>" class="field" required />
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="password" class="mb-2 block text-sm font-semibold text-slate-800">Password</label>
              <input type="password" id="password" name="password" placeholder="Minimum 8 characters" class="field" required />
            </div>
            <div>
              <label for="confirmPassword" class="mb-2 block text-sm font-semibold text-slate-800">Confirm password</label>
              <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Repeat password" class="field" required />
            </div>
          </div>

          <fieldset class="rounded-lg border border-stone-200 p-4">
            <legend class="px-1 text-sm font-semibold text-slate-800">Account type</legend>
            <div class="mt-3 grid gap-3 sm:grid-cols-2">
              <label class="flex cursor-pointer items-center gap-3 rounded-md border border-stone-200 p-4 transition hover:bg-stone-50">
                <input type="radio" name="userType" value="guest" class="h-4 w-4 text-rose-600" <%= oldInput.userType !== "host" ? "checked" : "" %> />
                <span>
                  <span class="block font-semibold text-slate-950">Guest</span>
                  <span class="block text-sm text-slate-500">Discover and book homes</span>
                </span>
              </label>
              <label class="flex cursor-pointer items-center gap-3 rounded-md border border-stone-200 p-4 transition hover:bg-stone-50">
                <input type="radio" name="userType" value="host" class="h-4 w-4 text-rose-600" <%= oldInput.userType === "host" ? "checked" : "" %> />
                <span>
                  <span class="block font-semibold text-slate-950">Host</span>
                  <span class="block text-sm text-slate-500">Publish and manage listings</span>
                </span>
              </label>
            </div>
          </fieldset>

          <label class="flex items-start gap-3 text-sm text-slate-600">
            <input type="checkbox" name="terms" id="terms" class="mt-1 h-4 w-4 rounded border-stone-300 text-rose-600" required />
            <span>I agree to the platform terms and guest-host community standards.</span>
          </label>

          <button type="submit" class="btn-primary w-full">Create account</button>
        </form>

        <p class="mt-6 text-center text-sm text-slate-600">
          Already have an account? <a href="/login" class="font-semibold text-rose-700 hover:text-rose-800">Log in</a>
        </p>
      </section>
    </main>
  </body>
</html>
