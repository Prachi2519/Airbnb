<%- include('../partials/head') %>
  </head>
  <body>
    <%- include('../partials/nav') %>
    <main class="section-shell">
      <%- include('../partials/flash') %>
      <div class="mb-8">
        <p class="text-sm font-semibold text-rose-700">Trips</p>
        <h1 class="mt-1 text-3xl font-bold tracking-tight text-slate-950">Your bookings</h1>
        <p class="mt-2 max-w-2xl text-slate-600">Confirmed stays, dates, guests, and trip totals in one place.</p>
      </div>

      <% if (!bookings || bookings.length === 0) { %>
        <div class="rounded-lg border border-dashed border-stone-300 bg-white p-10 text-center">
          <h2 class="text-xl font-semibold text-slate-950">No bookings yet</h2>
          <p class="mt-2 text-slate-600">When you book a stay, it will appear here instantly.</p>
          <a href="/homes" class="btn-primary mt-6">Find a stay</a>
        </div>
      <% } else { %>
        <div class="space-y-4">
          <% bookings.forEach(booking => { const home = booking.home; if (!home) return; %>
            <article class="grid gap-4 rounded-lg border border-stone-200 bg-white p-4 shadow-sm md:grid-cols-[12rem_1fr_auto] md:items-center">
              <img src="<%= assetPath((home.images && home.images[0]) || home.photo) %>" alt="<%= home.houseName %>" class="h-44 w-full rounded-md object-cover md:h-32" />
              <div>
                <h2 class="text-lg font-semibold text-slate-950"><%= home.houseName %></h2>
                <p class="mt-1 text-sm text-slate-500"><%= home.location %></p>
                <div class="mt-3 flex flex-wrap gap-2 text-sm text-slate-700">
                  <span class="badge"><%= formatDate(booking.checkIn) %> - <%= formatDate(booking.checkOut) %></span>
                  <span class="badge"><%= booking.nights %> nights</span>
                  <span class="badge"><%= booking.guestCount %> guests</span>
                  <span class="badge"><%= formatCurrency(booking.totalPrice) %></span>
                </div>
              </div>
              <a href="/homes/<%= home._id %>" class="btn-secondary">View stay</a>
            </article>
          <% }) %>
        </div>
      <% } %>
    </main>
  </body>
</html>
