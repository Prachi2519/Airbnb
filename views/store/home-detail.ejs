<%- include('../partials/head') %>
  </head>
  <body>
    <%- include('../partials/nav') %>
    <main class="section-shell">
      <%- include('../partials/flash') %>
      <div class="mb-6">
        <a href="/homes" class="text-sm font-semibold text-rose-700 hover:text-rose-800">Back to homes</a>
        <h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-950"><%= home.houseName %></h1>
        <p class="mt-2 text-slate-600"><%= home.location %> · <%= home.maxGuests || 2 %> guests · <%= home.bedrooms || 1 %> bedrooms · <%= home.bathrooms || 1 %> baths</p>
      </div>

      <% const gallery = (home.images && home.images.length ? home.images : [home.photo]).filter(Boolean); %>
      <section class="grid gap-3 overflow-hidden rounded-lg md:grid-cols-4 md:grid-rows-2">
        <% gallery.slice(0, 5).forEach((image, index) => { %>
          <img src="<%= assetPath(image) %>" alt="<%= home.houseName %>" class="<%= index === 0 ? 'md:col-span-2 md:row-span-2' : '' %> h-56 w-full object-cover md:h-full" />
        <% }) %>
      </section>

      <section class="mt-8 grid gap-8 lg:grid-cols-[1fr_24rem]">
        <div class="space-y-8">
          <section class="card p-6">
            <div class="flex items-start justify-between gap-4">
              <div>
                <h2 class="text-xl font-bold text-slate-950">Hosted by <%= home.host ? home.host.firstName : 'StayNest host' %></h2>
                <p class="mt-1 text-slate-600">Verified stay · Instant local confirmation</p>
              </div>
              <span class="badge"><%= home.rating %> rating</span>
            </div>
            <p class="mt-5 leading-7 text-slate-700"><%= home.description %></p>
          </section>

          <section class="card p-6">
            <h2 class="text-xl font-bold text-slate-950">What this place offers</h2>
            <div class="mt-4 grid gap-3 sm:grid-cols-2">
              <% (home.amenities || []).forEach(amenity => { %>
                <div class="rounded-md bg-stone-50 px-4 py-3 text-sm font-medium text-slate-700"><%= amenity %></div>
              <% }) %>
            </div>
          </section>

          <section class="card p-6">
            <h2 class="text-xl font-bold text-slate-950">House rules</h2>
            <ul class="mt-4 space-y-2 text-sm text-slate-700">
              <% (home.houseRules || []).forEach(rule => { %>
                <li class="flex gap-2"><span class="text-rose-600">•</span><span><%= rule %></span></li>
              <% }) %>
            </ul>
          </section>
        </div>

        <%- include('../partials/booking-panel', { home: home, unavailableDates: unavailableDates, oldInput: oldInput, errors: errors }) %>
      </section>
    </main>
  </body>
</html>
